[Unit]
Description=Maksut GHCR auto-deploy (git fast-forward + docker pull/up)
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/labile/projects/maxwell
Environment=PATH=/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
Environment=AUTO_DEPLOY_REPO=/home/labile/projects/maxwell
Environment=AUTO_DEPLOY_STATE_DIR=/home/labile/projects/maxwell/self-improve
ExecStart=/run/current-system/sw/bin/python3 /home/labile/projects/maxwell/tools/auto_deploy.py
