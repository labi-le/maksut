[Unit]
Description=Maksut GHCR fallback deploy (safety net for missed webhook events)
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/labile/projects/maxwell
Environment=PATH=/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
Environment=AUTO_DEPLOY_REPO=/home/labile/projects/maxwell
Environment=AUTO_DEPLOY_STATE_DIR=/home/labile/projects/maxwell/self-improve
# The shim runs tools/auto_deploy.py as published on origin/main, so deploy
# logic follows the repository even when the checkout carries uncommitted work.
ExecStart=/run/current-system/sw/bin/python3 /home/labile/projects/maxwell/tools/published_deploy.py
