[Unit]
Description=Maksut self-improvement orchestrator
After=docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/home/labile/projects/maksut
EnvironmentFile=/home/labile/projects/maksut/.env
Environment=PATH=/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
Environment=SELF_IMPROVE_REPO=/home/labile/projects/maksut
Environment=SELF_IMPROVE_DIR=/home/labile/projects/maksut/self-improve
Environment=SELF_IMPROVE_OMP=/run/current-system/sw/bin/omp
ExecStart=/run/current-system/sw/bin/python3 /home/labile/projects/maksut/tools/self_improve_orchestrator.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
